{
  "name": "@ripota/parks",
  "version": "3.0.3",
  "description": "Typed Rhode Island Parks on the Air reference metadata with opt-in reviewed geospatial artifacts.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "data",
    "dist",
    "schemas",
    "README.md",
    "DATA_LICENSE.md",
    "DATA_SOURCES.md",
    "LICENSE",
    "API.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog.json": "./dist/catalog.json",
    "./source-catalog.json": "./dist/source-catalog.json",
    "./all.geojson": "./dist/all.geojson",
    "./source-all.geojson": "./dist/source-all.geojson",
    "./checksums.sha256": "./dist/checksums.sha256",
    "./references.json": "./data/references.json",
    "./manifest.json": "./data/manifest.json",
    "./derivations.json": "./data/derivations.json",
    "./boundaries/*": "./dist/boundaries/*",
    "./source-features/*": "./data/source-features/*",
    "./schemas/catalog.schema.json": "./schemas/catalog.schema.json",
    "./schemas/geojson.schema.json": "./schemas/geojson.schema.json",
    "./schemas/v2/catalog.schema.json": "./schemas/v2/catalog.schema.json",
    "./schemas/v2/source-catalog.schema.json": "./schemas/v2/source-catalog.schema.json",
    "./schemas/v2/display-geojson.schema.json": "./schemas/v2/display-geojson.schema.json",
    "./schemas/v2/source-geojson.schema.json": "./schemas/v2/source-geojson.schema.json",
    "./schemas/v2/manifest.schema.json": "./schemas/v2/manifest.schema.json",
    "./display": {
      "types": "./dist/display.d.ts",
      "default": "./dist/display.js"
    },
    "./types": {
      "types": "./dist/public-types.d.ts",
      "default": "./dist/public-types.js"
    }
  },
  "scripts": {
    "update": "node --experimental-strip-types src/update.ts",
    "package": "node --experimental-strip-types src/package.ts",
    "package:check": "node --experimental-strip-types src/package.ts --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run package:check"
  },
  "devDependencies": {
    "@turf/area": "^7.2.0",
    "@turf/boolean-intersects": "^7.2.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.2",
    "jsts": "^2.12.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
