{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ripota.org/schemas/v3/catalog.schema.json",
  "title": "RI POTA schema-v3 display catalog",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "geometryRole",
    "referenceCount",
    "featureCount",
    "references"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://ripota.org/schemas/v3/catalog.schema.json"
    },
    "schemaVersion": {
      "const": 3
    },
    "geometryRole": {
      "const": "display"
    },
    "referenceCount": {
      "type": "integer",
      "minimum": 1
    },
    "featureCount": {
      "type": "integer",
      "minimum": 1
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "reference",
          "name",
          "latitude",
          "longitude",
          "grid",
          "counties",
          "locationDesc",
          "potaUrl",
          "status",
          "geometryKind",
          "geojson",
          "fidelity",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^US-[0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "mapPoint": {
            "type": "object",
            "required": ["latitude", "longitude", "notes"],
            "additionalProperties": false,
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "grid": {
            "type": "string",
            "minLength": 1
          },
          "counties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": " County$"
            }
          },
          "locationDesc": {
            "type": "string",
            "pattern": "(^|,)US-RI(,|$)"
          },
          "potaUrl": {
            "type": "string",
            "pattern": "^https://pota\\.app/#/park/US-[0-9]+$"
          },
          "status": {
            "enum": ["available", "point-only", "research-needed"]
          },
          "geometryKind": {
            "enum": ["boundary", "activation-zone", "point"]
          },
          "source": {
            "type": "object",
            "required": ["name", "url", "featureIds", "artifact"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "query": {
                "type": "string",
                "minLength": 1
              },
              "featureIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": ["string", "number"]
                }
              },
              "artifact": {
                "type": "string",
                "pattern": "^source-features/us-[0-9]+\\.geojson$"
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "geojson": {
            "$ref": "https://ripota.org/schemas/v3/display-geojson.schema.json"
          },
          "fidelity": {
            "enum": ["reviewed-display", "official-point-fallback"]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "url"],
            "properties": {
              "kind": {
                "enum": ["reviewed-source", "official-pota-coordinate"]
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "research-needed"
                }
              }
            },
            "then": {
              "not": {
                "required": ["source"]
              },
              "properties": {
                "geometryKind": {
                  "const": "point"
                },
                "fidelity": {
                  "const": "official-point-fallback"
                },
                "provenance": {
                  "properties": {
                    "kind": {
                      "const": "official-pota-coordinate"
                    }
                  }
                },
                "geojson": {
                  "properties": {
                    "features": {
                      "maxItems": 1,
                      "items": {
                        "properties": {
                          "geometry": {
                            "properties": {
                              "type": {
                                "const": "Point"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "else": {
              "required": ["source"],
              "properties": {
                "fidelity": {
                  "const": "reviewed-display"
                },
                "provenance": {
                  "properties": {
                    "kind": {
                      "const": "reviewed-source"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
