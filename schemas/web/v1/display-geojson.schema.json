{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ripota.org/schemas/web/v1/display-geojson.schema.json",
  "title": "RI POTA web display schema v1",
  "type": "object",
  "definitions": {
    "position": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "number"
      }
    },
    "linearRing": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/definitions/position"
      }
    },
    "polygonCoordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/linearRing"
      }
    }
  },
  "required": ["type", "properties", "features"],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "const": "https://ripota.org/schemas/web/v1/display-geojson.schema.json"
    },
    "type": {
      "const": "FeatureCollection"
    },
    "properties": {
      "type": "object",
      "required": ["schemaVersion", "geometryRole", "fidelity"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "geometryRole": {
          "const": "display"
        },
        "fidelity": {
          "const": "web"
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "properties", "geometry"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "const": "Feature"
          },
          "properties": {
            "type": ["object", "null"]
          },
          "geometry": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "coordinates"],
                "properties": {
                  "type": {
                    "const": "Point"
                  },
                  "coordinates": {
                    "$ref": "#/definitions/position"
                  }
                }
              },
              {
                "type": "object",
                "required": ["type", "coordinates"],
                "properties": {
                  "type": {
                    "const": "Polygon"
                  },
                  "coordinates": {
                    "$ref": "#/definitions/polygonCoordinates"
                  }
                }
              },
              {
                "type": "object",
                "required": ["type", "coordinates"],
                "properties": {
                  "type": {
                    "const": "MultiPolygon"
                  },
                  "coordinates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/definitions/polygonCoordinates"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
